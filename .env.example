# Local music:sync / music:watch / music:prune CLI only.
# Copy this file to .env.local and put real values there; .env.local is ignored by Git.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: overrides the standard account S3 endpoint. Do not append a bucket name or path.
R2_ENDPOINT=
# Public catalog URL, used by production builds. Set it in Cloudflare Pages.
# Local pnpm dev reads the generated local catalog instead.
VITE_CATALOG_URL=https://media.example.com/catalog.json
